// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and should never be committed.

#ifndef SECRETS_H
#define SECRETS_H

// Optional. With a key, weather comes from OpenWeatherMap; leave it empty
// to use the built-in key-free Open-Meteo service instead.
#define WEATHER_API_KEY         ""          // OpenWeatherMap API key
// Required for the weather feature. City name, e.g. "Mumbai".
#define WEATHER_CITY            ""
// POSIX timezone string. The number is what you add to local time to get UTC,
// so India (UTC+5:30, IST) is "IST-5:30". Other examples:
//   "GMT0"                  UTC
//   "CET-1CEST,M3.5.0,M10.5.0/3"   Central Europe with DST
//   "EST5EDT,M3.2.0,M11.1.0"       US Eastern with DST
#define TIMEZONE_OFFSET         "IST-5:30"
// Default Wi-Fi network. Used on first boot (or when the saved network is
// unreachable) so the clock connects without entering the password on screen.
// Leave both empty to rely on the on-screen Wi-Fi setup only.
#define WIFI_SSID               ""          // e.g. "MyHomeWiFi"
#define WIFI_PASSWORD           ""          // e.g. "my-secret-password"

#endif // SECRETS_H
